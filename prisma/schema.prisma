// Yusfaith database (Prisma)
// Shared storage for orders, chats, receipts, delivery fees, alerts and the
// activity log, so every phone and computer sees the same data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SharedItem {
  collection String
  id         String
  data       Json
  deleted    Boolean  @default(false)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([collection, id])
  @@index([updatedAt])
  @@map("shared_items")
}

/// A phone or computer that asked for alerts (Web Push).
/// Staff: audience "staff". Customers: audience "customer" + their order id.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String
  p256dh    String
  auth      String
  audience  String
  orderId   String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([endpoint, audience, orderId])
  @@index([audience, orderId])
  @@map("push_subscriptions")
}
